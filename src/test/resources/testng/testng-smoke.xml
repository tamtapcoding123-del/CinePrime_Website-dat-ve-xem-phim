<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Nhóm smoke: vài ca quan trọng chạy nhanh (< 1 phút) mỗi lần push/pull request. Chạy: mvnw test -Psmoke -->
<suite name="CinePrime-UI-Smoke" verbose="1">
  <test name="Smoke">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <packages>
      <package name="vn.cineprime.asm.ui.tests"/>
    </packages>
  </test>
</suite>

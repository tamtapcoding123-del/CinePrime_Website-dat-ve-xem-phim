extends layout
block head
  link(rel="stylesheet" href="/css/showtime-hub.css?v=20261116c")
  script(src="/js/showtime-hub.js?v=20261116c" defer)
block admin
  - var keep = '/admin/schedule?cinemaId=' + cinemaId + '&roomId=' + roomId + '&movieId=' + movieId + '&state=' + state + '&date='
  h1.visually-hidden Lịch trong ngày
  form.hub-context.hub-list(method="get" action="/admin/schedule")
    select(name="cinemaId" aria-label="Rạp" data-autosubmit="true")
      each c in adminCinemas
        option(value=c.id selected=cinemaId == c.id.toString())= c.name
    .hub-day(role="group" aria-label="Ngày chiếu")
      a.button.secondary.hub-step(href=keep + prevDay aria-label="Ngày trước (phím ←)" title="Ngày trước · phím ←" data-hotkey="ArrowLeft") ←
      label.hub-date
        span.num= dayLabel
        input(type="date" name="date" value=day required aria-label="Chọn ngày chiếu" data-autosubmit="true")
      a.button.secondary.hub-step(href=keep + nextDay aria-label="Ngày sau (phím →)" title="Ngày sau · phím →" data-hotkey="ArrowRight") →
      a.button.secondary(href=keep + todayDay title="Phím T" data-hotkey="t") Hôm nay
    .hub-filters(role="group" aria-label="Lọc suất chiếu")
      select(name="movieId" aria-label="Phim" data-autosubmit="true")
        option(value="") Tất cả phim
        each m in filterMovies
          option(value=m.id selected=movieId == m.id.toString())= m.name
      select#schedule-room(name="roomId" aria-label="Phòng" data-autosubmit="true")
        option(value="") Tất cả phòng
        each r in adminRooms
          option(value=r.id selected=roomId == r.id.toString())= r.name
      select(name="state" aria-label="Trạng thái" data-autosubmit="true")
        option(value="") Mở bán và nháp
        option(value="OPEN" selected=state == 'OPEN') Mở bán
        option(value="DRAFT" selected=state == 'DRAFT') Nháp
        option(value="CANCELLED" selected=state == 'CANCELLED') Đã huỷ
      noscript
        button.button(type="submit") Lọc
    a.button.primary.hub-add(href='/admin/showtimes/new?cinemaId=' + cinemaId + '&date=' + day + '&roomId=' + roomId + '&movieId=' + movieId + '&add=1' data-hotkey="n" title="Phím N")
      | + Thêm suất
      kbd N
  section.panel.tl(aria-label="Trục giờ theo phòng")
    .tl-head
      ul.hub-stats(aria-label="Số liệu trong ngày")
        li.tone-info
          strong.num= stats.total
          span suất · #{stats.roomsWithShows} phòng
        li.tone-ok
          strong.num= stats.open
          span= stats.live > 0 ? 'mở bán · ' + stats.live + ' đang chiếu' : 'mở bán'
        li.tone-off
          strong.num= stats.draft
          if stats.draft > 0
            a(href='/admin/manage/showtimes?cinemaId=' + cinemaId + '&date=' + day + '&state=DRAFT') nháp · mở bán →
          else
            span nháp
        li.tone-warn
          strong.num= stats.emptyRooms
          span(title=stats.emptyNames) phòng trống
      ul.tl-legend
        li
          span.sw.open
          | Mở bán
        li
          span.sw.draft
          | Nháp
        li
          span.sw.past
          | Đã chiếu
        li
          span.sw.fill
          | Đã bán
        li
          span.sw.clean
          | Dọn phòng
        li
          span.sw.now
          | Bây giờ
    if filterMovies.size() > 0
      .tl-films(aria-label="Phim trong ngày, mỗi phim một màu")
        strong Phim trong ngày
        each m in filterMovies
          a.tl-film(class='film-' + (m.id % 8) + (movieId == m.id.toString() ? ' active' : '') href='/admin/schedule?cinemaId=' + cinemaId + '&roomId=' + roomId + '&state=' + state + '&date=' + day + '&movieId=' + (movieId == m.id.toString() ? '' : m.id) title=movieId == m.id.toString() ? 'Bỏ lọc theo phim này' : 'Chỉ xem phim này')= m.name
    if boardRooms.size() == 0
      p.empty Rạp chưa có phòng hoạt động. Tạo phòng ở mục Rạp &amp; phòng trước khi xếp lịch.
    else
      .tl-grid(data-fit="96")
        .tl-scale
          span.tl-corner
          .tl-ruler
            each h in boardHours
              span.tl-hour(data-left=h.left)= h.label
        each r in boardRooms
          .tl-row(class=r.active ? '' : 'inactive')
            .tl-room
              strong= r.name
              small= r.meta
            .tl-track(data-add=r.active ? r.addLink : false data-from=boardFrom data-to=boardTo)
              each h in boardHours
                span.tl-line(data-left=h.left)
              each g in r.gaps
                a.tl-gap(href=g.link data-left=g.left data-width=g.width title='Thêm suất từ ' + g.from)
                  span + Thêm suất từ #{g.from}
              each b in r.bars
                span.tl-tail(data-left=b.tailLeft data-width=b.tailWidth)
                a(class=b.cls href='/admin/manage/showtimes/edit?id=' + b.id + '&returnTo=' + returnEncoded data-show-edit=b.id data-cinema=cinemaId data-date=b.date data-left=b.left data-width=b.width title=b.label aria-label=b.label)
                  strong.num= b.time
                  span= b.title
                  i.tl-fill(data-width=b.fill)
              if r.empty
                if r.active
                  a.tl-empty(href=r.addLink) Chưa có suất. Bấm để thêm suất cho phòng này.
                else
                  span.tl-empty Phòng đã ngừng hoạt động.
        //- 16/11/2026: the current time is a small pointer under the rooms, not a line across the shows.
        if showNow
          .tl-nowrow(aria-hidden="true")
            span.tl-corner
            .tl-nowtrack(data-from=boardFrom data-to=boardTo)
              span.tl-cursor(data-left=nowLeft data-now=nowLabel)
                span.tl-cursor-time.num= nowLabel
    .tl-foot
      if attention.size() == 0
        span.status-badge.tone-ok Ổn
        span.grow Không có khoảng trống dài hay suất nháp. Bấm một suất để sửa, bấm khoảng trống để thêm suất.
      else
        each a in attention
          span.tl-note
            span.status-badge(class='tone-' + a.tone)= a.chip
            span= a.text
            a(href=a.link)= a.linkText
